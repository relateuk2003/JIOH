[sub_resource type="Resource" id="Resource_2lcqq"]
script = ExtResource("5_q1pxq")
message_id = &"mail_brennan"
available_from_day = 2
sender = "Denise <office@brennanscaffolding.co.uk>"
subject = "Tower extension, Block B"
body = "Morning,

Confirming we are back {day:4} to Extend tower scaffold to the L2 landing, Block B, east stair as per the drawing. Can you have the permit ready for the lads. Job ref as on our last sheet.

Regards
Denise
Brennan Scaffolding Ltd"
fact_ids = Array[StringName]([&"s_desc", &"s_site"])

[sub_resource type="Resource" id="Resource_fjecq"]
script = ExtResource("5_q1pxq")
message_id = &"mail_moyes"
available_from_day = 2
sender = "Kev Moyes <kev@moyesjoinery.co.uk>"
subject = "Fire door 2.04 - J2211"
body = "Hi,

Got the order through, our job is J2211. Rehang the fire door to 2.04 and fit a new closer. It's Room 2.04 on your second floor.

Kev"
fact_ids = Array[StringName]([&"c_jobno", &"c_desc", &"c_loc"])

[sub_resource type="Resource" id="Resource_6hgxe"]
script = ExtResource("5_q1pxq")
message_id = &"mail_janice"
sender = "Janice <janice.office@site>"
subject = "Bits and bobs"
body = "Love,

Printer needs a thump if it sulks. Stamp is in the top drawer, wind it before you use it, I never do. Key book is on top of the pigeon holes.

J x"

[sub_resource type="Resource" id="Resource_hrvi4"]
