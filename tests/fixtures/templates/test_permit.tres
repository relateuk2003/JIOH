[gd_resource type="Resource" script_class="DocumentTemplate" load_steps=5 format=3]

[ext_resource type="Script" path="res://resources/documents/document_template.gd" id="1_tpl"]
[ext_resource type="Script" path="res://resources/documents/document_field.gd" id="2_field"]

[sub_resource type="Resource" id="Resource_ref"]
script = ExtResource("2_field")
key = &"permit_no"
printed_label = "Permit No."
